{
  "name": "@kitevi/pi-de",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "VS Code file references for Pi through /ide and /ide-setup.",
  "keywords": ["pi-package", "vscode"],
  "repository": {
    "type": "git",
    "url": "https://github.com/kitevi/pide"
  },
  "author": "Pierre Borckmans",
  "contributors": ["kitevi"],
  "license": "MIT",
  "engines": {
    "node": ">=22.17.0"
  },
  "pi": {
    "extensions": ["./index.ts"]
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && npm --prefix vscode-plugin run compile",
    "package:vscode": "npm --prefix vscode-plugin run package"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
